-- 1. Қонақүйдің орташа рейтингін есептеу
CREATE OR REPLACE FUNCTION get_avg_rating()
RETURNS NUMERIC AS $$
BEGIN
    RETURN (SELECT AVG(rating) FROM hotel);
END;
$$ LANGUAGE plpgsql;


SELECT get_avg_rating();

-- 2.Бөлменің жалпы құнын есептеу
CREATE OR REPLACE FUNCTION calculate_total_stay(p_room_id INT, p_days INT)
RETURNS NUMERIC AS $$
DECLARE
    v_price NUMERIC;
BEGIN
    SELECT price_per_night INTO v_price FROM room WHERE room_id = p_room_id;
    RETURN v_price * p_days;
END;
$$ LANGUAGE plpgsql;


SELECT calculate_total_stay(1, 5); -- 1-ші бөлмеде 5 күн тұру құны

-- 3.Қонақтың аты-жөнін ID бойынша алу
CREATE OR REPLACE FUNCTION get_guest_name(p_guest_id INT)
RETURNS VARCHAR AS $$
DECLARE
    v_name VARCHAR;
BEGIN
    SELECT full_name INTO v_name FROM guest WHERE guest_id = p_guest_id;
    RETURN COALESCE(v_name, 'Табылмады');
END;
$$ LANGUAGE plpgsql;


SELECT get_guest_name(1);

-- 4.Көрсетілген қызметтердің жалпы санын алу
CREATE OR REPLACE FUNCTION count_services_used(p_res_id INT)
RETURNS INT AS $$
BEGIN
    RETURN (SELECT SUM(quantity) FROM service_usage WHERE reservation_id = p_res_id);
END;
$$ LANGUAGE plpgsql;


SELECT count_services_used(1);

