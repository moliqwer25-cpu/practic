--	Жүйелік триггер 
CREATE OR REPLACE FUNCTION log_ddl_event()
RETURNS event_trigger AS $$
BEGIN
    RAISE NOTICE 'ДҚ құрылымы өзгерді: % командасы орындалды', tg_tag;
END;
$$ LANGUAGE plpgsql;

CREATE EVENT TRIGGER trg_system_ddl_log
ON ddl_command_start
EXECUTE FUNCTION log_ddl_event();


