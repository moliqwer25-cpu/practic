--	Жол деңгейіндегі триггер 
CREATE OR REPLACE FUNCTION update_room_status_func()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE room SET status = 'Occupied' 
    WHERE room_id = NEW.room_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_update_room_status
AFTER INSERT ON reservation
FOR EACH ROW EXECUTE FUNCTION update_room_status_func();


