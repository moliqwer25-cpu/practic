-- 	Лог-триггер 
CREATE TABLE audit_log (
    log_id SERIAL PRIMARY KEY,
    table_name VARCHAR(50),
    operation VARCHAR(10),
    changed_at TIMESTAMP DEFAULT NOW(),
    user_name VARCHAR(50)
);

CREATE OR REPLACE FUNCTION log_changes_func()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO audit_log (table_name, operation, user_name)
    VALUES (TG_TABLE_NAME, TG_OP, CURRENT_USER);
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_guest_log
AFTER INSERT OR UPDATE OR DELETE ON guest
FOR EACH ROW EXECUTE FUNCTION log_changes_func();


UPDATE guest SET phone = '87777777777' WHERE guest_id = 3;
SELECT * FROM guest;

-- Оператор деңгейіндегі триггер 
CREATE OR REPLACE FUNCTION notify_mass_update_func()
RETURNS TRIGGER AS $$
BEGIN
    RAISE NOTICE 'Кестеде жаппай өзгеріс орындалды: %', TG_TABLE_NAME;
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_room_mass_update
AFTER UPDATE ON room
FOR EACH STATEMENT EXECUTE FUNCTION notify_mass_update_func();


UPDATE room SET price_per_night = price_per_night + 500;

--	INSTEAD OF триггер
CREATE VIEW guest_summary AS
SELECT full_name, phone FROM guest;

CREATE OR REPLACE FUNCTION instead_of_guest_func()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO guest (full_name, phone)
    VALUES (NEW.full_name, NEW.phone);
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_instead_guest
INSTEAD OF INSERT ON guest_summary
FOR EACH ROW EXECUTE FUNCTION instead_of_guest_func();


